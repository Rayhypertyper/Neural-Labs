  "narrative": {
    "northStar": "The curiosity lab",
    "overview": "A cheerful research game with the clarity of a science exhibition catalogue. Soft lilac ground, white work surfaces, precise separators and colorful learning stages make consequential experiments approachable. Geist supplies a clear technical voice without making the workspace feel corporate.\n\nSpecimen photography and the player's own evidence lead the experience. Generous introductions give way to practical controls, a notebook and an on-demand field guide. Keep the language clear, encouraging and specific about the next decision; scientific metrics stay precise and visibly simulated.",
    "keyCharacteristics": [
      "Locally bundled Geist, clean hierarchy and tabular metrics.",
      "Violet actions with lilac, peach, blue and pistachio learning stages.",
      "Flat white work surfaces with selective lift for specimens and temporary layers.",
      "Educational context beside consequential controls."
    ],
    "rules": [
      {
        "name": "The Paired Ink Rule",
        "body": "Keep each pastel stage with its corresponding dark ink. Color supports the stage name, sequence number and written state.",
        "section": "colors"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Keep working panels flat; use lift to distinguish specimens, temporary context and an explicit interaction.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use locally bundled Geist with clear weight and size hierarchy.",
      "**Do** retain paired pastel stages and their dark, reviewed text colors.",
      "**Do** give specimens, decisions and recorded evidence clear visual priority.",
      "**Do** keep labels, units, learning context and simulated-state explanations visible.",
      "**Do** preserve keyboard focus, drawer dismissal and reduced-motion behavior."
    ],
    "donts": [
      "**Don't** turn the learning lab into a corporate dashboard, course or spreadsheet interface.",
      "**Don't** restore the previous Nunito and mint visual system in new screens.",
      "**Don't** tilt reading surfaces or data grids.",
      "**Don't** add strong floating shadows to every panel.",
      "**Don't** rely on color alone for progress, readiness or selection."
    ]
  }
